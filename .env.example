# Required in production. Generate a high-entropy value; never commit the real secret.
SESSION_SECRET=<generate-a-long-random-secret>
DATABASE_URL=postgresql://spacetradingfx:<database-password>@db:5432/spacetradingfx
DB_PASSWORD=<database-password>
REDIS_URL=redis://redis:6379/0
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
LICENSE_PUBLIC_KEY_PEM=<rsa-public-key-pem>
LICENSE_PRIVATE_KEY_PEM=<rsa-private-key-pem>
LIVE_TRADING_ENABLED=false
MT5_ORDER_EXECUTION_ENABLED=false
# Safe by default; set to alphavantage only with a real provider key.
MARKET_DATA_PROVIDER=simulation
ALPHA_VANTAGE_API_KEY=<provider-api-key>
